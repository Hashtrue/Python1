#Maximum and minimum number from a list

numbers = [4, 6, 1, 8, 3]

max_number = numbers[0]
min_number = numbers[0]

for num in numbers:
    if num>max_number:
        max_number = num
    if num<min_number:
        min_number = num

print("Maximum number is ",max_number,",", "Minimum number is ", min_number)
