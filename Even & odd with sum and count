num = int(input("Enter a number: "))
sum_even=0
sum_odd=0
count_even=0
count_odd=0
for i in range (1,num+1):
    if i%2==0:
        sum_even=sum_even+i
        count_even=count_even+1
    else: 
        sum_odd=sum_odd+i
        count_odd=count_odd+1
print("sum of even number from 1 to", i, "is", sum_even)
print("sum of odd numbers from 1 to", i, "is", sum_odd)
print("count of even numbers from 1 to", i, "is",  count_even)
print("count of odd numbers from 1 to", i, "is",  count_odd)








