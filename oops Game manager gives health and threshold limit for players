class Player:
    def __init__(self,name,health):
        self.name= name
        self.health = health

    def heal(self,amount):
        if self.health<100:
            self.health+=amount
            if self.health>100:
                self.health=100
            return True
        return False

class GameManager:
    def __init__(self, players):
        self.players = players

    def heal_weak_players(self,amount,threshold):
        count= 0
        for player in self.players:
            if player.health<threshold:
                healed = player.heal(amount)
                if healed:
                    count+=1
        return count

players = []
for i in range(1,100):
    name = f"player(i)"
    health = i%100
    players.append(Player(name,health))


manager = GameManager(players)

count = manager.heal_weak_players(30,50)

print(f"players healed = {count}")

print("\nSample player name with health" )

for player in players[:10]:
    print(f"Player = {player.name}, health = {player.health}")
