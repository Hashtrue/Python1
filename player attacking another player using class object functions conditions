class Player:
    def __init__(self, name, health):
        self.name = name
        self.health = health
        
    def is_alive(self):
        return self.health>0
        
    def take_damage(self, damage):
        if self.is_alive():
            if damage<self.health:
                self.health-=damage
            else:
                self.health=0
                
    def attack(self, other_player, damage): 
        if self.is_alive() and other_player.is_alive():
            other_player.take_damage(damage)

player1 = Player("alex", 80)
player2 = Player("ben", 40)

player1.attack(player2, 30)

print(player1.health)
print(player2.health)




