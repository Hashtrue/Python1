
def count_even(N):
    count_even = 0
    sum_even = 0
    for i in range(1,N+1):
        if i%2==0:
            sum_even = sum_even+i
            count_even = count_even+1 
    return sum_even, count_even
    
N = int(input("Enter a number = "))
sum_result,count_result = count_even(N)

print(sum_result,",",count_result)
